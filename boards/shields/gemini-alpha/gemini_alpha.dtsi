#include <dt-bindings/zmk/matrix_transform.h> // Put this with the other includes at the top of your dtsi

/ {
	chosen {
		zmk,physical-layout = &physical_layout0;
		// Other chosen items
	};

	physical_layout0: physical_layout_0 { // First physical layout, use different naming for other layouts
		compatible = "zmk,physical-layout";
		display-name = "Default Layout";
		kscan = <&kscan0>; // Label of the kscan node, optional if all layouts use the same
		transform = <&default_transform>; // Label of the matrix transform for this layout
	};

	default_transform: keymap_transform0 {
		compatible = "zmk,matrix-transform";
		columns = <15>;
		rows = <8>;
		map = <
			RC(0,0)         RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)      RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)
			RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)      RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14)
			RC(2,0)         RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)      RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14)
			RC(3,0)         RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)      RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)
			RC(4,0)         RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6)      RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13)
			RC(5,0) RC(5,1) RC(5,2) RC(5,3)         RC(5,5)                      RC(5,8)         RC(5,10) RC(5,11) RC(5,12) RC(5,13)
			                                RC(6,4) RC(6,5) RC(6,6)      RC(6,7) RC(6,8) RC(6,9)
											RC(7,4) RC(7,5) RC(7,6)      RC(7,7) RC(7,8) RC(7,9)
		>;
	};

	kscan0: kscan0 {
		compatible = "zmk,kscan-gpio-matrix";
		diode-direction = "col2row";
		wakeup-source;

		row-gpios
			= <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			;
	};
};
